#!/bin/sh /etc/rc.common
# wlan-guard-mqtt — procd service wrapping `wlan-guard.sh listen`.
# Subscribes to MQTT_CMD_TOPIC (from /etc/wlan-guard.conf) and runs
# `wlan-guard.sh unblock <payload>` for each message it receives, so an
# ip/mac/'all' published there is released immediately instead of waiting
# out the hold. Requires MQTT_HOST to be set in /etc/wlan-guard.conf; if it
# is not, `wlan-guard.sh listen` exits right away and procd just respawns it.

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /root/wlan-guard.sh listen
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
